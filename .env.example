# =====================================================
# UPI PAYMENT BACKEND - ENVIRONMENT CONFIGURATION
# =====================================================

# 🖥️ SERVER
NODE_ENV=development
PORT=3000

# 🗄️ DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/upi_db
DB_LOGGING=true

# 🔐 JWT AUTHENTICATION
# ⚠️ CRITICAL: Use same secret for signing and verifying tokens
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# 🔴 REDIS CACHE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 🌐 CORS
CORS_ORIGIN=*

# 💳 PAYMENT PROVIDER CONFIGURATION
# ⚠️ These are test keys - replace with production keys before deploying

# Razorpay (Default Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_SiBM4N1hcd7Gvm
RAZORPAY_KEY_SECRET=VXK36PhEJZW9AwgRv0I8pIZW
RAZORPAY_WEBHOOK_SECRET=Zxcvbnm@123
RAZORPAY_WEBHOOK_URL=https://your-domain.com/webhook/razorpay

# Cashfree (Alternative Payment Gateway)
# CASHFREE_KEY_ID=test_key_123456
# CASHFREE_KEY_SECRET=test_secret_789012
# CASHFREE_WEBHOOK_SECRET=cashfree_webhook_123
# CASHFREE_WEBHOOK_URL=https://your-domain.com/webhook/cashfree

# 📧 EMAIL CONFIGURATION (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@upi-app.com

# 📱 SMS CONFIGURATION (for notifications)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE=+1234567890

# 🔔 PUSH NOTIFICATION (Firebase)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY=your-private-key
# FIREBASE_CLIENT_EMAIL=your-client-email@firebase.gserviceaccount.com

# =====================================================
# ADMIN SETTINGS (Managed via /admin/settings endpoints)
# =====================================================
# These are database-configurable settings - see UPI_PAYMENT_FLOW.md
#
# payment_provider: RAZORPAY | CASHFREE
# otp_expiry: OTP validity in seconds (default: 300)
# max_transaction_amount: Maximum rupees per transaction (default: 100000)
#
# Configure via:
# PUT /admin/payment-provider
# GET /admin/settings
# PUT /admin/settings/{key}